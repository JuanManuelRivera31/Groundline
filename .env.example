# Copy to .env and fill in. Never commit .env.
# Required for real embedding calls (free tier only, no billing).
GEMINI_API_KEY=

# Embedding model and dimensions (defaults: gemini-embedding-001 / 768).
# Changing EMBEDDING_DIMS requires a schema migration (chunks.embedding is vector(768)).
EMBEDDING_MODEL=
EMBEDDING_DIMS=
EMBEDDING_BATCH_SIZE=

# Client-side quota limits for the embedding model (defaults: 60 / 20000 / 800).
GEMINI_EMBED_RPM=
GEMINI_EMBED_TPM=
GEMINI_EMBED_RPD=
GEMINI_MAX_RETRIES=

# Local Postgres (docker compose). Defaults: port 54329, user/db/password "groundline".
PG_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Optional full override, e.g. for Neon in later sessions.
DATABASE_URL=

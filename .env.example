# Copy to .env and fill in. Never commit .env.
# Required for real embedding calls (free tier only, no billing).
GEMINI_API_KEY=

# Embedding model and dimensions (defaults: gemini-embedding-001 / 768).
# Changing EMBEDDING_DIMS requires a schema migration (chunks.embedding is vector(768)).
EMBEDDING_MODEL=
EMBEDDING_DIMS=
EMBEDDING_BATCH_SIZE=

# Client-side quota limits for the embedding model (defaults: 60 / 20000 / 800).
GEMINI_EMBED_RPM=
GEMINI_EMBED_TPM=
GEMINI_EMBED_RPD=
GEMINI_MAX_RETRIES=

# Local Postgres (docker compose). Defaults: port 54329, user/db/password "groundline".
PG_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Optional full override, e.g. for Neon in later sessions.
DATABASE_URL=

# Answer generation (free tier only). Defaults: gemini-3.5-flash-lite, temperature 0 (max 0.2),
# 1024 output tokens, thinking level MINIMAL (OFF omits thinkingConfig), schema field responseJsonSchema.
# Model chain for live mode (primary first; eval mode uses only the primary).
# Default: gemini-3.5-flash-lite,gemini-3.1-flash-lite. GEN_MODEL alone is a legacy one-model chain.
GEN_MODELS=
GEN_MODEL=
# Live mode time budget per answer in ms (default 7500: a network margin under the 8 s target).
GEN_LIVE_BUDGET_MS=
# Live mode hedge in ms (default 3000): if the primary has not answered by then, the next chain
# model starts in parallel and the first valid answer wins. 0 disables it. Eval mode never hedges.
HEDGE_AFTER_MS=
# Prompt version from packages/core/src/answer/prompts (default v4).
ANSWER_PROMPT_VERSION=
GEN_TEMPERATURE=
GEN_MAX_OUTPUT_TOKENS=
GEN_THINKING_LEVEL=
GEN_SCHEMA_FIELD=
# Client-side quota limits for the generation model (defaults: 10 / 100000 / 200; check AI Studio).
GEN_RPM=
GEN_TPM=
GEN_RPD=
# Per-model limits, overriding GEN_RPM/TPM/RPD: "model=rpm/tpm/rpd;model2=rpm/tpm/rpd".
GEN_LIMITS=

# Answering. Defaults: vector retrieval, 20 candidates, 6 sources (URL groups), floor 0.600 (ADR-0009).
RETRIEVAL_MODE=
RETRIEVAL_CANDIDATES=
ANSWER_SOURCES=
ANSWER_FLOOR=

# Demo API (apps/api, ADR-0012). pnpm dev:api listens on 127.0.0.1:API_PORT (default 8787).
API_PORT=
# Comma-separated exact origins allowed by CORS, e.g. https://demo.example.com. Empty: none.
CORS_ORIGINS=
# Bearer token for /v1/admin/* (at least 32 characters). Empty: the admin API is disabled.
ADMIN_TOKEN=
# Key for the daily IP-hash salt (at least 32 characters). Required on Workers; on Node a random
# per-process key is used when empty.
IP_HASH_SECRET=
# Per-IP limits (defaults 3 per minute, 15 per UTC day) and question length (default 500).
RATE_LIMIT_PER_MINUTE=
RATE_LIMIT_PER_DAY=
MAX_QUESTION_CHARS=
# Generation requests per chain model per Pacific day before articles-only mode (default 150).
DEMO_DAILY_GEN_CAP=
# Replace the default regional block list (EEA, CH, GB and related codes), comma-separated.
BLOCKED_COUNTRIES=
# Node only: country assumed for local requests, and whether the x-groundline-dev-country
# header may override it (1 = yes) for manual tests.
DEV_COUNTRY=
DEV_COUNTRY_HEADER=
# Days before conversations and hand-off cases are deleted (default 30).
RETENTION_DAYS=
# Hand-off delivery in a real deployment: https URL (email relay, Slack incoming webhook, ...),
# body format json|slack, optional HMAC signing secret and timeout in ms (default 5000).
HANDOFF_WEBHOOK_URL=
HANDOFF_WEBHOOK_FORMAT=
HANDOFF_WEBHOOK_SECRET=
HANDOFF_WEBHOOK_TIMEOUT_MS=
